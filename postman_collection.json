{
  "info": {
    "name": "Smart API Hub",
    "description": "Bộ collection đầy đủ cho Smart API Hub – Dynamic REST API với Node.js, Express, TypeScript, Knex, PostgreSQL.",
    "_postman_id": "smart-api-hub-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT token – tự động set sau khi chạy request Login"
    }
  ],
  "item": [
    {
      "name": "🔧 System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Kiểm tra server và DB còn hoạt động không."
          },
          "response": []
        }
      ]
    },
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"user\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Đăng ký tài khoản mới. Role có thể là 'user' hoặc 'admin'."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "  pm.collectionVariables.set('token', res.access_token);",
                  "  console.log('✅ Token đã được lưu vào biến {{token}}');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Đăng nhập. Token JWT sẽ tự động được lưu vào biến {{token}}."
          },
          "response": []
        }
      ]
    },
    {
      "name": "📦 CRUD – Users",
      "item": [
        {
          "name": "GET /users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users?_page=1&_limit=10",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [
                { "key": "_page", "value": "1" },
                { "key": "_limit", "value": "10" },
                { "key": "_sort", "value": "created_at", "disabled": true },
                { "key": "_order", "value": "desc", "disabled": true },
                { "key": "_fields", "value": "id,email,role", "disabled": true },
                { "key": "q", "value": "", "disabled": true }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /users/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/YOUR_UUID_HERE",
              "host": ["{{base_url}}"],
              "path": ["users", "YOUR_UUID_HERE"]
            }
          },
          "response": []
        },
        {
          "name": "POST /users",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"user\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            }
          },
          "response": []
        },
        {
          "name": "PUT /users/:id",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"updated@example.com\",\n  \"password\": \"newpassword123\",\n  \"role\": \"user\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/users/YOUR_UUID_HERE",
              "host": ["{{base_url}}"],
              "path": ["users", "YOUR_UUID_HERE"]
            }
          },
          "response": []
        },
        {
          "name": "PATCH /users/:id",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"admin\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/users/YOUR_UUID_HERE",
              "host": ["{{base_url}}"],
              "path": ["users", "YOUR_UUID_HERE"]
            }
          },
          "response": []
        },
        {
          "name": "DELETE /users/:id",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/users/YOUR_UUID_HERE",
              "host": ["{{base_url}}"],
              "path": ["users", "YOUR_UUID_HERE"]
            },
            "description": "Chỉ Admin mới có quyền xóa."
          },
          "response": []
        }
      ]
    },
    {
      "name": "🗂️ CRUD – Categories",
      "item": [
        {
          "name": "GET /categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/categories?_page=1&_limit=10",
              "host": ["{{base_url}}"],
              "path": ["categories"],
              "query": [
                { "key": "_page", "value": "1" },
                { "key": "_limit", "value": "10" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /categories/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/categories/YOUR_UUID_HERE",
              "host": ["{{base_url}}"],
              "path": ["categories", "YOUR_UUID_HERE"]
            }
          },
          "response": []
        },
        {
          "name": "POST /categories",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"Thiết bị điện tử\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/categories",
              "host": ["{{base_url}}"],
              "path": ["categories"]
            }
          },
          "response": []
        },
        {
          "name": "PATCH /categories/:id",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Category\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/categories/YOUR_UUID_HERE",
              "host": ["{{base_url}}"],
              "path": ["categories", "YOUR_UUID_HERE"]
            }
          },
          "response": []
        },
        {
          "name": "DELETE /categories/:id",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/categories/YOUR_UUID_HERE",
              "host": ["{{base_url}}"],
              "path": ["categories", "YOUR_UUID_HERE"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "🛒 CRUD – Products",
      "item": [
        {
          "name": "GET /products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products?_page=1&_limit=10&_expand=users&_embed=categories",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "_page", "value": "1" },
                { "key": "_limit", "value": "10" },
                { "key": "_expand", "value": "users", "description": "Expand quan hệ cha (users)" },
                { "key": "_embed", "value": "categories", "disabled": true },
                { "key": "_sort", "value": "price", "disabled": true },
                { "key": "_order", "value": "asc", "disabled": true },
                { "key": "price_gte", "value": "100000", "disabled": true, "description": "Lọc price >= 100000" },
                { "key": "price_lte", "value": "500000", "disabled": true },
                { "key": "q", "value": "", "disabled": true, "description": "Full-text search" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /products/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products/YOUR_UUID_HERE",
              "host": ["{{base_url}}"],
              "path": ["products", "YOUR_UUID_HERE"]
            }
          },
          "response": []
        },
        {
          "name": "POST /products",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Laptop Gaming\",\n  \"price\": 25000000,\n  \"user_id\": \"YOUR_USER_UUID\",\n  \"category_id\": \"YOUR_CATEGORY_UUID\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/products",
              "host": ["{{base_url}}"],
              "path": ["products"]
            }
          },
          "response": []
        },
        {
          "name": "PUT /products/:id",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Laptop Gaming Pro\",\n  \"price\": 30000000,\n  \"user_id\": \"YOUR_USER_UUID\",\n  \"category_id\": \"YOUR_CATEGORY_UUID\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/products/YOUR_UUID_HERE",
              "host": ["{{base_url}}"],
              "path": ["products", "YOUR_UUID_HERE"]
            }
          },
          "response": []
        },
        {
          "name": "PATCH /products/:id",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 27000000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/products/YOUR_UUID_HERE",
              "host": ["{{base_url}}"],
              "path": ["products", "YOUR_UUID_HERE"]
